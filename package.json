{
  "name": "camnook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/local-development.mjs start",
    "build": "next build",
    "catalog:photos": "node scripts/catalog-photo-publication.mjs",
    "launch:verify": "node scripts/production-launch-readiness.mjs",
    "launch:require-go": "node scripts/production-launch-readiness.mjs --require-go",
    "meetup:check:development": "node scripts/run-vitest.mjs --env RUN_MEETUP_PROVIDER_DEVELOPMENT_CHECK=1 -- run src/features/meetups/provider.development.test.ts",
    "meetup:routing:check:development": "node scripts/run-vitest.mjs --env RUN_MEETUP_ROUTING_DEVELOPMENT_CHECK=1 -- run src/features/meetups/routing-provider.development.test.ts",
    "psgc:validate": "node scripts/psgc-reference.mjs validate",
    "psgc:sql": "node scripts/psgc-reference.mjs sql",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "verify:push": "pnpm lint && pnpm typecheck && pnpm test && pnpm launch:verify && pnpm build",
    "db:start": "pnpm dlx supabase@2.114.0 start",
    "db:stop": "pnpm dlx supabase@2.114.0 stop",
    "db:reset": "pnpm dlx supabase@2.114.0 db reset",
    "db:test": "pnpm dlx supabase@2.114.0 test db",
    "db:test:concurrency": "bash supabase/tests/database/003_approval_concurrency.sh",
    "db:types": "pnpm dlx supabase@2.114.0 gen types typescript --local --schema public,api > src/types/database.generated.ts",
    "db:types:linked": "pnpm dlx supabase@2.114.0 gen types typescript --linked --schema public,api > src/types/database.generated.ts",
    "dev:setup": "node scripts/local-development.mjs setup",
    "dev:check": "node scripts/local-development.mjs check",
    "dev:real": "node scripts/local-development.mjs start",
    "dev:session": "node scripts/development-session.mjs",
    "dev:renter": "node scripts/development-renter.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "leaflet": "1.9.4",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.20.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.20",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  }
}
