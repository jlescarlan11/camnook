# Public values. Safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional until hosted CAPTCHA is enabled for the target environment. This is
# Cloudflare's browser-visible site key, never the Turnstile secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Never prefix server-only secrets with NEXT_PUBLIC_. Add them only when a
# reviewed server operation actually needs them; browser flows use RLS.
# Government-ID mutation RPCs require this only inside Server Actions and the
# cleanup worker. Never expose it to client code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Random server-only value of at least 16 characters. Vercel Cron sends it as
# an Authorization bearer token to the internal retention worker.
CRON_SECRET=replace-with-a-long-random-server-only-secret

# Server-only Resend inbound-forwarding configuration for the monitored privacy
# contact. Use a dedicated Resend API key and webhook signing secret. The
# destination must be an existing, actively monitored inbox and must not equal
# privacy@camnook.shop. Never commit real values.
RESEND_API_KEY=replace-with-a-dedicated-resend-api-key
RESEND_WEBHOOK_SECRET=replace-with-the-resend-webhook-signing-secret
PRIVACY_FORWARD_TO=monitored-inbox@example.com

# Server-only pickup instructions. They are rendered only for the authenticated
# owner of a CONFIRMED booking. Configure reviewed operational values in each
# Vercel environment; do not use a public prefix or commit a private address or
# personal contact detail here.
PICKUP_LOCATION=reviewed pickup location
PICKUP_CONTACT=reviewed pickup contact
PICKUP_PROCESS=reviewed arrival and handoff process

# Server-only Geoapify meetup recommendation boundary. Configure only after the
# provider/terms review in docs/operations/geoapify-meetups.md. Never expose the
# API key or encryption secret through NEXT_PUBLIC_ variables.
GEOAPIFY_API_KEY=
MEETUP_RECOMMENDATION_SECRET=
MEETUP_ALLOWED_CATEGORIES=commercial.shopping_mall,public_transport.train,public_transport.bus,activity.community_center
MEETUP_PROVIDER_CONFIG_VERSION=geoapify-v1
MEETUP_PROVIDER_TIMEOUT_MS=4000
MEETUP_SEARCH_RADIUS_METERS=8000

# Server-only rollout gate for recommendation-backed booking requests. Enable
# only after the meetup schema, service-role key, provider config, and handoff
# scheduling gate are verified in the target environment.
MEETUP_PLANNING_ENABLED=false
