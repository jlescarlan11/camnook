# Public values. Safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional until hosted CAPTCHA is enabled for the target environment. This is
# Cloudflare's browser-visible site key, never the Turnstile secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Never prefix server-only secrets with NEXT_PUBLIC_. Add them only when a
# reviewed server operation actually needs them; browser flows use RLS.
