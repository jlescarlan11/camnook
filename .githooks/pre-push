#!/bin/sh
set -eu

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"
remote_name="${1:-origin}"

if ! git diff --quiet --ignore-submodules -- ||
  ! git diff --cached --quiet --ignore-submodules --; then
  echo "pre-push: commit or restore tracked changes before pushing" >&2
  exit 1
fi

is_zero_oid() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

while read -r local_ref local_oid _remote_ref remote_oid; do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  if is_zero_oid "$local_oid"; then
    continue
  fi

  if ! is_zero_oid "$remote_oid"; then
    diff_base="$remote_oid"
  elif remote_head="$(git rev-parse --verify "refs/remotes/$remote_name/HEAD^{commit}" 2>/dev/null)" &&
    merge_base="$(git merge-base "$local_oid" "$remote_head" 2>/dev/null)"; then
    diff_base="$merge_base"
  else
    diff_base="$(git hash-object -t tree /dev/null)"
  fi

  if ! git diff --check "$diff_base" "$local_oid"; then
    echo "pre-push: outgoing commits contain whitespace errors or conflict markers" >&2
    exit 1
  fi
done

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm is required to run repository checks" >&2
  exit 1
fi

echo "pre-push: running lint, type-check, tests, launch evidence, and production build"
pnpm verify:push
